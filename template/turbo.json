{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME"],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": ["gen/**", "generated/**"]
    },
    "@repo/ui#gen": {
      "dependsOn": ["//#gen"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["gen", "//#gen", "^build"],
      "outputs": ["dist/**", "generated/**", "storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["gen", "//#gen", "^build"],
      "outputs": [".vibe/declarations/**"]
    },
    "test": {
      "dependsOn": ["gen", "//#gen", "^build"],
      "outputs": [".cache/test-result-*.json"],
      "env": ["VIBESTACK_QUINT_EVALUATOR"]
    },
    "test:browser": {
      "dependsOn": ["gen", "//#gen", "^build"],
      "outputs": [],
      "env": ["VIBESTACK_QUINT_EVALUATOR"]
    },
    "check": {
      "dependsOn": ["build", "typecheck", "test", "test:browser"],
      "cache": false
    },
    "//#gen": {
      "env": ["!VITE_*"],
      "inputs": ["spec/**", "apps/*/package.json", "apps/*/spec/**", "packages/*/package.json", "packages/*/spec/**", "package.json"],
      "outputs": ["gen/**", "apps/*/gen/**", "packages/*/gen/**"]
    },
    "//#typecheck": {
      "dependsOn": ["//#gen"],
      "inputs": ["package.json", "tsconfig.json", "spec/**", "src/**", "test/**", "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**", "!**/.DS_Store"],
      "outputs": []
    },
    "//#test": {
      "dependsOn": ["//#gen", "^build"],
      "inputs": ["package.json", "vitest.config.ts", "spec/**", "!spec/**/*.md", "src/**", "test/**", "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**", "!**/.DS_Store"],
      "outputs": [".cache/test-result-*.json"],
      "env": ["VIBESTACK_QUINT_EVALUATOR"]
    },
    "//#check": {
      "dependsOn": ["//#typecheck", "//#test", "@repo/app#build", "@repo/app#typecheck", "@repo/app#test", "@repo/app#test:browser"],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": ["@repo/design-system#build", "@repo/app#typecheck"],
      "inputs": ["apps/**", "packages/**", "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**", "!**/.DS_Store", "!{apps,packages}/**/gen/**", "package.json", "pnpm-workspace.yaml", "tsconfig.json", "*.config.js", "*.config.ts"],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": ["**/*.css", "!.claude/**", "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**", "!**/.DS_Store", "!{apps,packages}/**/gen/**", "stylelint.config.js", "package.json", "pnpm-workspace.yaml"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "@repo/ui#build": {
      "dependsOn": ["^build"],
      "inputs": ["package.json", "src/**", "styles.css", "tsconfig.json"],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".vibe/declarations/**"]
    },
    "@repo/design-system#build": {
      "dependsOn": ["^build"],
      "outputs": ["generated/**", "design.md"]
    }
  }
}
