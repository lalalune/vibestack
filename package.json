{
  "name": "vibestack-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev //#studio",
    "studio": "node packages/vibestack/src/spec.ts studio template",
    "cli": "node template/packages/cli/src/main.ts",
    "check": "node packages/vibestack/src/spec.ts check template",
    "gen": "node packages/vibestack/src/spec.ts gen template",
    "accept": "node packages/vibestack/src/spec.ts accept template",
    "new": "node packages/vibestack/src/spec.ts new",
    "demo": "pnpm -C examples/order demo",
    "selftest": "node packages/vibestack/src/spec.ts tasks //#selftest:tools:a //#selftest:tools:b //#selftest:tools:rest //#selftest:docs //#selftest:examples",
    "selftest:tools:a": "node --test --test-name-pattern=\"^the tools each check catches its own kind of mistake in shard a \" selftest/selftest.ts",
    "selftest:tools:b": "node --test --test-name-pattern=\"^the tools each check catches its own kind of mistake in shard b \" selftest/selftest.ts",
    "selftest:tools:rest": "node --test --test-skip-pattern=\"^the tools each check catches its own kind of mistake in shard [ab] \" selftest/selftest.ts",
    "selftest:docs": "node --test --test-name-pattern=\"^the documents name what exists \" selftest/selftests/docs.ts",
    "selftest:examples": "node --test --test-name-pattern=\"^the standalone examples \" selftest/selftests/examples.ts",
    "build": "node packages/vibestack/src/spec.ts tasks vibestack#build vibestack-studio#build create-vibestack#build",
    "pnpm:devPreinstall": "node packages/vibestack/src/skill-links.ts",
    "prepare": "node packages/vibestack/src/spec.ts gen --install --skip-gen-on-pack vibestack#build",
    "test": "vitest run",
    "test:browser": "node packages/vibestack/src/spec.ts tasks test:browser",
    "test:models": "node packages/vibestack/src/spec.ts tasks check",
    "typecheck": "vibelang --noEmit -p tsconfig.json",
    "lint": "node packages/vibestack/src/spec.ts tasks //#lint:js //#lint:css",
    "lint:js": "eslint . --config eslint.config.js --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "analyze": "knip && madge --circular apps packages template selftest && jscpd .",
    "quick": "node packages/vibestack/src/spec.ts tasks typecheck test //#lint:js //#lint:css",
    "verify": "node packages/vibestack/src/spec.ts tasks build typecheck test test:browser check //#lint:js //#lint:css //#analyze //#selftest:tools:a //#selftest:tools:b //#selftest:tools:rest //#selftest:docs //#selftest:examples",
    "all": "node packages/vibestack/src/spec.ts tasks"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.7.10",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@informalsystems/quint": "^0.33.1",
    "@types/node": "^26.6.6",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "4.1.1",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "happy-dom": "catalog:",
    "jscpd": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lemmascript": "0.6.9",
    "madge": "catalog:",
    "miniflare": "5.20261113.0-beta",
    "playwright": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "turbo": "catalog:",
    "typescript": "^6.0.3",
    "typescript-eslint": "catalog:",
    "vibelang": "0.0.13",
    "vibelang-runtime": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.24.0"
}
