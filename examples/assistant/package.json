{
  "name": "assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "spec check",
    "gen": "spec gen",
    "accept": "spec accept",
    "build": "vibelang",
    "test": "vitest run",
    "demo": "pnpm -s gen && node --import vibelang/register src/demo.vibe",
    "dev:cf": "ALCHEMY_FAST_DISTILLED=1 alchemy dev",
    "deploy": "ALCHEMY_FAST_DISTILLED=1 alchemy deploy --yes --no-input",
    "deploy:plan": "ALCHEMY_FAST_DISTILLED=1 alchemy plan",
    "test:deploy": "vitest run -c deploy/vitest.config.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "@cloudflare/workers-types": "^4.20260429.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "^26.0.0",
    "alchemy": "2.0.0-beta.85",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vibestack": "file:../../packages/vibestack",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.1.1"
    }
  }
}
