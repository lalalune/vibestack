{
  "name": "fullstack-todo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "spec check",
    "gen": "spec gen",
    "accept": "spec accept",
    "tokens": "spec tokens build",
    "stories": "spec stories gen --check",
    "storybook": "pnpm -s tokens && storybook dev --no-open",
    "build:web": "pnpm -s tokens && vite build",
    "build": "vibelang && pnpm -s build:web",
    "test": "pnpm -s tokens && pnpm -s stories && vite build --logLevel error && vitest run",
    "lint": "pnpm -s tokens && spec tokens check && eslint src/web",
    "start": "node -e \"import('node:fs').then(async({existsSync,readdirSync,statSync})=>{const{execFileSync}=await import('node:child_process');const pnpm=process.platform==='win32'?'pnpm.cmd':'pnpm';const o={stdio:'inherit',shell:process.platform==='win32'};const max=(p)=>!existsSync(p)?0:statSync(p).isDirectory()?Math.max(0,...readdirSync(p).map(e=>max(p+'/'+e))):statSync(p).mtimeMs;const fresh=(out,ins)=>existsSync(out)&&Math.max(...ins.map(max))<=statSync(out).mtimeMs;if(!fresh('dist/src/main.js',['src','gen','tsconfig.json','package.json']))execFileSync(pnpm,['-s','exec','vibelang'],o);if(!fresh('dist/web/index.html',['src/web','gen','tokens.json','vite.config.ts','package.json']))execFileSync(pnpm,['-s','run','build:web'],o);})\" && node dist/src/main.js",
    "dev:cf": "pnpm -s build:web && ALCHEMY_FAST_DISTILLED=1 alchemy dev",
    "deploy": "pnpm -s build:web && ALCHEMY_FAST_DISTILLED=1 alchemy deploy --yes --no-input",
    "deploy:plan": "pnpm -s build:web && ALCHEMY_FAST_DISTILLED=1 alchemy plan",
    "test:deploy": "pnpm -s build:web && vitest run -c deploy/vitest.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "@antithesishq/bombadil": "0.7.10",
    "@cloudflare/workers-types": "^4.20260429.1",
    "@effect/vitest": "4.1.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "alchemy": "2.0.0-beta.85",
    "eslint": "10.14.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "happy-dom": "21.0.4",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vibestack": "file:../../packages/vibestack",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.1.1"
    }
  }
}
