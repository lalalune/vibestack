{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME"],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "packages/vibestack/src/*.ts",
    "packages/vibestack/src/gen/**",
    "packages/vibestack/src/proof/**",
    "packages/vibestack/src/std/**",
    "packages/vibestack/src/testing/**",
    "packages/vibestack/src/stories/**",
    "packages/vibestack/src/design/**",
    "!packages/vibestack/**/{node_modules,.cache}/**",
    "!packages/vibestack/src/remote-cache.ts",
    "!packages/vibestack/src/proof/lib.dfy",
    "!packages/vibestack/src/testing/test/**",
    "!packages/vibestack/src/stories/test/**",
    "!packages/vibestack/src/design/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "scripts/**",
        "src/**",
        "!src/testing/test/**",
        "!src/stories/test/**",
        "!src/design/test/**",
        "$TURBO_ROOT$/.agents/skills/**",
        "$TURBO_ROOT$/.agents/claude-settings.json",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/SPEC.md",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": [
        "dist/**",
        "assets/**",
        "README.md",
        "LICENSE"
      ]
    },
    "vibestack#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "vibestack#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/template/packages/design-system/tokens.json",
        "$TURBO_ROOT$/template/packages/design-system/design.md"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "create-vibestack#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/template/**",
        "$TURBO_ROOT$/LICENSE",
        "!$TURBO_ROOT$/template/**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,gen}/**",
        "!$TURBO_ROOT$/template/**/.DS_Store",
        "!template/**"
      ],
      "outputs": [
        "dist/**",
        "template/**",
        "LICENSE"
      ]
    },
    "create-vibestack#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "create-vibestack#test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "vibestack#build"
      ],
      "cache": false
    },
    "//#gen": {
      "env": ["!VITE_*"],
      "inputs": [
        "template/spec/**",
        "template/apps/*/package.json",
        "template/apps/*/spec/**",
        "template/packages/*/package.json",
        "template/packages/*/spec/**",
        "template/package.json",
        "package.json"
      ],
      "outputs": [
        "template/gen/**",
        "template/apps/*/gen/**",
        "template/packages/*/gen/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "selftest/**",
        "packages/vibestack/src/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "package.json",
        "vitest.config.ts"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "vibestack#build",
        "vibestack-studio#build",
        "create-vibestack#build",
        "vibestack#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "packages/vibestack/**",
        "packages/studio/**",
        "selftest/**",
        "examples/order/**",
        "!selftest/selftests/{docs,examples}.ts",
        "!packages/vibestack/{assets,README.md,LICENSE}/**",
        "!packages/vibestack/README.md",
        "!packages/vibestack/LICENSE",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages/studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "vibestack#build",
        "vibestack-studio#build",
        "create-vibestack#build",
        "vibestack#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "packages/vibestack/**",
        "packages/studio/**",
        "selftest/**",
        "examples/order/**",
        "!selftest/selftests/{docs,examples}.ts",
        "!packages/vibestack/assets/**",
        "!packages/vibestack/README.md",
        "!packages/vibestack/LICENSE",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages/studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "vibestack#build",
        "vibestack-studio#build",
        "create-vibestack#build",
        "vibestack#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        ".gitignore",
        "eslint.config.js",
        "packages/vibestack/**",
        "packages/studio/**",
        "packages/create-vibestack/**",
        "selftest/**",
        "examples/order/**",
        "template/**",
        "!selftest/selftests/{docs,examples}.ts",
        "!packages/vibestack/assets/**",
        "!packages/vibestack/README.md",
        "!packages/vibestack/LICENSE",
        "!packages/create-vibestack/template/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{template,packages/studio,examples}/**/gen/**",
        "patches/**",
        "apps/*/package.json",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!packages/vibestack/assets/**",
        "!packages/vibestack/README.md",
        "!packages/vibestack/LICENSE",
        "!packages/create-vibestack/template/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{template,packages/studio,examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "dependsOn": [
        "vibestack#build"
      ],
      "inputs": [
        "packages/vibestack/**",
        "selftest/selftests/examples.ts",
        "selftest/selftests/install.ts",
        "examples/**",
        "!packages/vibestack/assets/**",
        "!packages/vibestack/README.md",
        "!packages/vibestack/LICENSE",
        "!packages/vibestack/src/testing/test/**",
    "!packages/vibestack/src/stories/test/**",
    "!packages/vibestack/src/design/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{template,packages/studio,examples}/**/gen/**",
        "package.json"
      ],
      "outputs": [
        "examples/*/.spec-cache/tests-*.json.{gz,zst}"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#check": {
      "dependsOn": [
        "vibestack#build",
        "//#typecheck",
        "//#test",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/app#typecheck",
        "vibestack-studio#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "template/**",
        "selftest/**",
        "!packages/vibestack/assets/**",
        "!packages/create-vibestack/template/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{template,packages/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!packages/create-vibestack/template/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{template,packages/studio}/**/gen/**",
        "!examples/**",
        "!selftest/fixtures/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": ["//#gen", "vibestack#build", "@repo/design-system#build", "@repo/ui#gen", "vibestack-studio#gen"],
      "inputs": [
        "apps/**",
        "packages/**",
        "template/**",
        "selftest/**",
        "!packages/vibestack/assets/**",
        "!packages/create-vibestack/template/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{template,packages/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": ["!VITE_*"],
      "outputs": ["gen/**", "generated/**"]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/selftest/fixtures/**",
        "$TURBO_ROOT$/packages/vibestack/src/proof/lib.dfy",
        "!$TURBO_ROOT$/selftest/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/site#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@repo/site#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
